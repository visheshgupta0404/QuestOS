# Copy to .env.local. Never commit populated credentials.
APP_URL=http://localhost:3000
# Local SQLite needs Node 22.13+ and a persistent disk. Not supported on Vercel.
QUESTOS_STORAGE=local
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set both true only AFTER verifying access to questos-513307 and rotating the exposed secret.
GOOGLE_PROJECT_VERIFIED=false
GOOGLE_SECRET_ROTATED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Only anonymous task counts go to Gemini, never email content or file names.
GEMINI_API_KEY=
# Set an available Gemini model ID from your AI Studio account.
GEMINI_MODEL=
